<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>34.1.0</version>
	</parent>
	<artifactId>janelia-jhdf5</artifactId>
	<version>22.03.01-SNAPSHOT</version>
	<name>JHDF5</name>
	<description>SciJava JHDF5 from Janelia</description>
	<url>https://mycompany.com/imagej/gauss-filtering/</url>                   <!-- FIXME: Your project website here -->
	<inceptionYear>2023</inceptionYear>                                        <!-- FIXME: Your project starting year here -->
	<organization>
		<name>Howard Hughes Medical Institute</name>           <!-- FIXME: Your organization name here -->
		<url>https://www.janelia.org/</url> <!-- FIXME: Your organization website here -->
	</organization>
	<licenses>
		<license>                         <!-- FIXME: Your license here -->
			<name>BSD-3-Clause</name>
			<url>https://www.janelia.org/open-science/software-licensing</url>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<!-- See https://imagej.net/Team -->
		<developer>
			<id>mkitti</id>
			<name>Mark Kittisopikul</name>
			<url>https://www.janelia.org/people/mark-kittisopikul/</url>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>debugger</role>
				<role>reviewer</role>
				<role>support</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>None</name>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/imagej</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/JaneliaSciComp/janelia-jhdf5</connection>
		<developerConnection>scm:git:git@github.com:JaneliaSciComp/janelia-jhdf5</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/JaneliaSciComp/janelia-jhdf5</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/JaneliaSciComp/janelia-jhdf5</url>
	</issueManagement>
	<ciManagement>
		<system>None</system>
	</ciManagement>
	<dependencies>
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>hdf5</artifactId>
			<version>${hdf5.version}</version>
		</dependency>
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>hdf5</artifactId>
			<version>${hdf5.version}</version>
			<classifier>macosx-arm64</classifier>
		</dependency>
		<dependency>
		    <groupId>com.github.jnr</groupId>
		    <artifactId>jnr-posix</artifactId>
		</dependency>
		<dependency>
		    <groupId>commons-io</groupId>
		    <artifactId>commons-io</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.apache.commons</groupId>
		    <artifactId>commons-lang3</artifactId>
		</dependency>
		<dependency>
			<groupId>args4j</groupId>
			<artifactId>args4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>7.5.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jmock</groupId>
			<artifactId>jmock</artifactId>
			<version>2.12.0</version>
			<scope>test</scope>
			<exclusions>
				<!-- Annotation-only jars, not referenced by our test code; they duplicate
				     classes with transitive dependencies already pulled in elsewhere. -->
				<exclusion>
					<groupId>com.google.code.findbugs</groupId>
					<artifactId>annotations</artifactId>
				</exclusion>
				<exclusion>
					<groupId>net.jcip</groupId>
					<artifactId>jcip-annotations</artifactId>
				</exclusion>
				<!-- TestNG already brings in the modern, unified org.hamcrest:hamcrest,
				     which already provides everything jmock's own hamcrest-core needs. -->
				<exclusion>
					<groupId>org.hamcrest</groupId>
					<artifactId>hamcrest-core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- org.bytedeco:hdf5 leaves slf4j <optional>, so consumers (here, our own
		     tests) must supply a binding themselves; hdf.hdf5lib.H5's static
		     initializer references it unconditionally. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<suiteXmlFiles>
						<suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
					</suiteXmlFiles>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<pluginRepositories>
		<pluginRepository>
			<id>sonatype-nexus-snapshots</id>
			<url>https://oss.sonatype.org/content/repositories/snapshots</url>
		</pluginRepository>
	</pluginRepositories>


	<properties>
		<package-name>org.scijava.janelia.jhdf5</package-name>
		<main-class>org.scijava.janelia.jhdf5.Demo</main-class>
		<license.licenseName>BSD-3-Clause</license.licenseName>
		<license.copyrightOwners>Howard Hughes Medical Institute</license.copyrightOwners>
		<javacpp.version>1.5.15-SNAPSHOT</javacpp.version>
		<hdf5.version>2.2.0-1.5.15-SNAPSHOT</hdf5.version>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
		<repository>
			<id>sonatype-nexus-snapshots</id>
			<url>https://oss.sonatype.org/content/repositories/snapshots</url>
		</repository>
	</repositories>

</project>