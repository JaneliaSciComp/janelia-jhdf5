	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/JaneliaSciComp/janelia-jhdf5/actions</url>
	</ciManagement>
	<dependencies>
		<!-- The HDF5 classes plus the natives for every platform; JavaCPP loads the ones for the
		     platform it runs on. Build with -Djavacpp.platform=<platform> to bundle just one. -->
		<dependency>
			<groupId>org.bytedeco</groupId>
			<artifactId>hdf5-platform</artifactId>
			<version>${hdf5.version}</version>
		</dependency>
		<dependency>
		    <groupId>com.github.jnr</groupId>
		    <artifactId>jnr-posix</artifactId>
		</dependency>
		<dependency>
		    <groupId>commons-io</groupId>
		    <artifactId>commons-io</artifactId>
		</dependency>
		<dependency>
		    <groupId>org.apache.commons</groupId>
		    <artifactId>commons-lang3</artifactId>
		</dependency>
		<dependency>
			<groupId>args4j</groupId>
			<artifactId>args4j</artifactId>
		</dependency>
		<dependency>
			<groupId>org.testng</groupId>
			<artifactId>testng</artifactId>
			<version>7.5.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.jmock</groupId>
			<artifactId>jmock</artifactId>
			<version>2.12.0</version>
			<scope>test</scope>
			<exclusions>
				<!-- Annotation-only jars, not referenced by our test code; they duplicate
				     classes with transitive dependencies already pulled in elsewhere. -->
				<exclusion>
					<groupId>com.google.code.findbugs</groupId>
					<artifactId>annotations</artifactId>
				</exclusion>
				<exclusion>
					<groupId>net.jcip</groupId>
					<artifactId>jcip-annotations</artifactId>
				</exclusion>
				<!-- TestNG already brings in the modern, unified org.hamcrest:hamcrest,
				     which already provides everything jmock's own hamcrest-core needs. -->
				<exclusion>
					<groupId>org.hamcrest</groupId>
					<artifactId>hamcrest-core</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<!-- org.bytedeco:hdf5 leaves slf4j <optional>, so consumers (here, our own
		     tests) must supply a binding themselves; hdf.hdf5lib.H5's static
		     initializer references it unconditionally. -->
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-nop</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<suiteXmlFiles>
						<suiteXmlFile>src/test/resources/testng.xml</suiteXmlFile>
					</suiteXmlFiles>
					<environmentVariables>
						<!-- HDF5ArchiverTest's expected listings (and its .h5ar fixtures) were
						     written in this time zone. -->
						<TZ>Europe/Zurich</TZ>
						<!-- The tests close an HDF5 file and immediately reopen it. On machines
						     where another process (endpoint security scanners, cloud sync) briefly
						     opens freshly written files, HDF5's own file locking then fails
						     intermittently with "Unable to lock file". The tests run in a single
						     process and do not rely on that locking. -->
						<HDF5_USE_FILE_LOCKING>FALSE</HDF5_USE_FILE_LOCKING>
					</environmentVariables>
					<systemPropertyVariables>
						<!-- Java ignores the TZ environment variable on Windows. -->
						<user.timezone>Europe/Zurich</user.timezone>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>


	<properties>
		<package-name>org.scijava.janelia.jhdf5</package-name>
		<main-class>org.scijava.janelia.jhdf5.Demo</main-class>
		<license.licenseName>BSD-3-Clause</license.licenseName>
		<license.copyrightOwners>Howard Hughes Medical Institute</license.copyrightOwners>
		<javacpp.version>1.5.15-SNAPSHOT</javacpp.version>
		<hdf5.version>2.2.0-1.5.15-SNAPSHOT</hdf5.version>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
		<!-- org.bytedeco snapshots (the oss.sonatype.org snapshot repository is shut down). -->
		<repository>
			<id>central-portal-snapshots</id>
			<url>https://central.sonatype.com/repository/maven-snapshots/</url>
			<releases><enabled>false</enabled></releases>
			<snapshots><enabled>true</enabled></snapshots>
		</repository>
	</repositories>

</project>